<!DOCTYPE html>
<html lang="ca">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>FemRipollet – Plans per a joves</title>
<style>
:root{--bg:#f6f9ff;--card:#fff;--text:#1b2233;--muted:#586178;--p:#e8433c;--s:#2457d6;--soft:#e3ebff;--line:#dbe3f3;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#11151f;--card:#1a2030;--text:#eef1f8;--muted:#a1abc2;--p:#ff6b63;--s:#7da2ff;--soft:#222c47;--line:#2a3350;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#11151f;--card:#1a2030;--text:#eef1f8;--muted:#a1abc2;--p:#ff6b63;--s:#7da2ff;--soft:#222c47;--line:#2a3350;color-scheme:dark}
html{scroll-behavior:smooth;scroll-padding-top:70px}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:16px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
h1,h2,h3{font-family:Georgia,"Times New Roman",serif;line-height:1.2;margin:0 0 .5em}
nav{position:sticky;top:0;z-index:5;background:var(--bg);border-bottom:1px solid var(--line);display:flex;gap:1rem;align-items:center;padding:.7rem 1rem;overflow-x:auto;white-space:nowrap}
nav b{color:var(--p);font-size:1.2rem;margin-right:auto}
nav a{text-decoration:none;color:var(--muted);font-size:.9rem}
section{max-width:980px;margin:auto;padding:3rem 1.2rem}
.hero{text-align:center;padding:4rem 1.2rem 3rem}
.logo{width:86px;height:86px;border-radius:50%;background:var(--s);color:#fff;display:grid;place-items:center;font-size:2.6rem;margin:0 auto 1rem;border:5px solid var(--p)}
.hero h1{font-size:clamp(2.4rem,9vw,4rem)}.hero h1 span{color:var(--p)}
.slogan{font-size:1.3rem;color:var(--s);font-weight:600}
.btn{display:inline-block;background:var(--p);color:#fff;border:0;padding:.8rem 1.4rem;border-radius:999px;font-weight:700;text-decoration:none;cursor:pointer;font:inherit;font-weight:700;margin:.3rem}
.btn.alt{background:transparent;color:var(--s);border:2px solid var(--s)}
.value{background:var(--soft);border-left:5px solid var(--s);padding:1rem 1.2rem;border-radius:12px;font-style:italic}
.grid{display:grid;gap:1rem;grid-template-columns:repeat(auto-fit,minmax(230px,1fr))}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:1.2rem}
.card .ic{font-size:2rem}
.tag{display:inline-block;background:var(--soft);color:var(--s);border-radius:999px;padding:.1rem .7rem;font-size:.8rem;font-weight:700}
.filters{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:1.2rem}
.filters button{border:1px solid var(--line);background:var(--card);color:var(--text);padding:.4rem 1rem;border-radius:999px;font:inherit;cursor:pointer}
.filters button.on{background:var(--s);color:#fff;border-color:var(--s)}
.alt-bg{background:var(--card);border-block:1px solid var(--line)}
.news article{border-left:3px solid var(--p);padding-left:1rem;margin-bottom:1.2rem}
small,.muted{color:var(--muted)}
form{display:grid;gap:.7rem;max-width:480px}
input,textarea,select{font:inherit;padding:.7rem;border-radius:10px;border:1px solid var(--line);background:var(--card);color:var(--text);width:100%}
footer{text-align:center;padding:2rem 1rem;color:var(--muted);font-size:.9rem;border-top:1px solid var(--line)}
</style>
</head>
<body>
<nav><b>📍 FemRipollet</b><a href="#idea">La idea</a><a href="#plans">Plans</a><a href="#public">Per a qui</a><a href="#novetats">Novetats</a><a href="#contacte">Contacte</a></nav>

<header class="hero">
<div class="logo">📍</div>
<h1>Fem<span>Ripollet</span></h1>
<p class="slogan">Ripollet té plans. Només cal descobrir-los.</p>
<p>La guia feta per joves, per a joves: què fer, on anar i amb qui, sense sortir del poble.</p>
<a class="btn" href="#plans">Veure plans</a><a class="btn alt" href="#contacte">Proposa’ns un pla</a>
</header>

<section id="idea">
<h2>La nostra idea</h2>
<p>Molts cops diem «aquí no hi ha res a fer» i acabem a casa o marxant a Barcelona. Però al poble hi ha activitats, espais i festes que gairebé ningú coneix. Nosaltres ho recollim tot en un sol lloc i el fem fàcil de trobar.</p>
<div class="value">«Ajudem els joves de Ripollet a descobrir què fer al seu poble mitjançant una guia col·laborativa de plans, perquè l’oci més proper és el que menys es coneix.»</div>
<h3 style="margin-top:1.5rem">L’equip</h3>
<div class="grid">
<div class="card"><div class="ic">🧭</div><b>Coordinació</b><br><span class="muted">Calendari i decisions.</span></div>
<div class="card"><div class="ic">🎨</div><b>Disseny</b><br><span class="muted">Logotip, colors i fotos.</span></div>
<div class="card"><div class="ic">✍️</div><b>Continguts</b><br><span class="muted">Textos i descripcions.</span></div>
<div class="card"><div class="ic">💻</div><b>Digital</b><br><span class="muted">Web i funcionament.</span></div>
<div class="card"><div class="ic">📣</div><b>Comunicació</b><br><span class="muted">Novetats i xarxes.</span></div>
</div>
</section>

<div class="alt-bg"><section id="plans">
<h2>Què pots fer a Ripollet</h2>
<div class="filters" id="filters"></div>
<div class="grid" id="list"></div>
<p><small>Abans de publicar, comproveu horaris, preus i adreces de cada pla i afegiu-hi fotos pròpies.</small></p>
</section></div>

<section id="public">
<h2>Per a qui és</h2>
<p>Per a l’alumnat de l’institut (<b>12 a 18 anys</b>) i les seves colles:</p>
<div class="grid">
<div class="card"><b>🧑‍🤝‍🧑 Amb la colla</b><p class="muted">Plans per fer amb amics, de dia o de tarda.</p></div>
<div class="card"><b>💸 Amb poc pressupost</b><p class="muted">Etiquetem els plans gratuïts perquè la butxaca no sigui excusa.</p></div>
<div class="card"><b>🆕 Si ets nou al poble</b><p class="muted">Una forma ràpida de conèixer espais i gent.</p></div>
</div>
</section>

<div class="alt-bg"><section id="novetats" class="news">
<h2>Novetats</h2>
<article><small>Aquesta setmana</small><h3>Hem obert la guia!</h3><p>Ja hi ha els primers plans. Ens en falten molts: ajuda’ns a completar-la.</p></article>
<article><small>Pròximament</small><h3>Pla del mes</h3><p>Cada mes destacarem un pla escollit per votació de l’alumnat.</p></article>
<article><small>Enquesta</small><h3>Què us falta a Ripollet?</h3><p>Responeu a l’enquesta del pati i la publicarem aquí amb els resultats.</p></article>
</section></div>

<section id="contacte">
<h2>Contacte i participació</h2>
<p>Coneixes un lloc o una activitat que no surt a la guia? Escriu-nos!</p>
<form id="f">
<input id="n" placeholder="El teu nom i curs" required>
<select id="t"><option>Proposo un pla</option><option>Vull unir-me a l’equip</option><option>Tinc un dubte</option></select>
<textarea id="m" rows="4" placeholder="Explica’ns-ho…"></textarea>
<button class="btn" type="submit">Envia el missatge</button>
</form>
<p>📧 <a href="mailto:femripollet@exemple.cat" style="color:var(--s)">femripollet@exemple.cat</a> &nbsp; 📸 Instagram: @femripollet</p>
</section>
<footer>FemRipollet · Projecte Ripoll Emprèn · Fet per l’alumnat</footer>

<script>
(function(){
var D=[
{c:"Jovent",i:"🎉",t:"Casal de Joves",d:"L’espai del poble per als joves: activitats, tallers i propostes de lleure, com les jornades amb aigua de l’estiu.",f:"Informa’t del programa"},
{c:"Cultura",i:"🎭",t:"Centre Cultural",d:"Punt de trobada cultural amb pati i activitats al llarg de l’any, com les campanades infantils de Cap d’Any.",f:"Consulta l’agenda"},
{c:"Festes",i:"🎄",t:"Bosc Màgic de Nadal",d:"Cada Nadal el poble s’il·lumina amb un bosc màgic i una programació per a totes les edats.",f:"Novembre–desembre"},
{c:"Natura",i:"🚴",t:"Ruta pel riu Ripoll",d:"Passejada o volta en bici per l’entorn del riu. Proposta de l’equip: afegiu-hi el recorregut real i fotos.",f:"Gratis"},
{c:"Cultura",i:"📜",t:"Arxiu Històric",d:"Descobreix la història de Ripollet. Ideal per a treballs de classe o per curiosos.",f:"Pregunta horaris"},
{c:"Jovent",i:"⚽",t:"Torneig de l’institut",d:"Idea FemRipollet: un torneig esportiu o de videojocs organitzat per l’alumnat.",f:"Proposta"}
];
var cats=["Tots"].concat(D.map(function(x){return x.c}).filter(function(v,i,a){return a.indexOf(v)==i}));
var fb=document.getElementById('filters'),ls=document.getElementById('list');
function show(c){
ls.innerHTML=D.filter(function(x){return c=="Tots"||x.c==c}).map(function(x){
return '<div class="card"><div class="ic">'+x.i+'</div><h3>'+x.t+'</h3><span class="tag">'+x.c+'</span> <span class="tag">'+x.f+'</span><p>'+x.d+'</p></div>'}).join('');
fb.querySelectorAll('button').forEach(function(b){b.className=b.textContent==c?'on':''});}
cats.forEach(function(c){var b=document.createElement('button');b.textContent=c;b.onclick=function(){show(c)};fb.appendChild(b)});
show("Tots");
document.getElementById('f').onsubmit=function(e){e.preventDefault();
var s=encodeURIComponent('FemRipollet: '+document.getElementById('t').value);
var b=encodeURIComponent(document.getElementById('n').value+'\n\n'+document.getElementById('m').value);
location.href='mailto:femripollet@exemple.cat?subject='+s+'&body='+b;};
})();
</script>
</body>
</html>
